{
  "applicationId": "com.mycompany.myapp",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/",
  "enableInspector": true,
  "enableServer": true,
  "enableNativeAPI": true,
  "exportAuthInfo": true,
  "tokenSecurity": "none",
  "logging": {
    "enabled": true
  },
  "nativeAllowList": [
    "app.*",
    "app.exit",
    "app.killProcess",
    "app.restartProcess",
    "app.getConfig",
    "app.broadcast",
    "app.getProcessId",
    "app.readProcessInput",
    "app.writeProcessOutput",
    "app.writeProcessError",
    "window.*",
    "window.setTitle",
    "window.getTitle",
    "window.maximize",
    "window.unmaximize",
    "window.isMaximized",
    "window.minimize",
    "window.unminimize",
    "window.isMinimized",
    "window.setFullScreen",
    "window.exitFullScreen",
    "window.isFullScreen",
    "window.show",
    "window.hide",
    "window.isVisible",
    "window.focus",
    "window.setIcon",
    "window.move",
    "window.center",
    "window.setSize",
    "window.getSize",
    "window.getPosition",
    "window.setAlwaysOnTop",
    "window.create",
    "window.beginDrag",
    "window.setDraggableRegion",
    "window.unsetDraggableRegion",
    "window.snapshot",
    "window.print",
    "window.setBorderless",
    "window.setMainMenu",
    "events.*",
    "events.broadcast",
    "events.on",
    "events.off",
    "events.dispatch",
    "filesystem.*",
    "filesystem.createDirectory",
    "filesystem.remove",
    "filesystem.readFile",
    "filesystem.writeFile",
    "filesystem.readBinaryFile",
    "filesystem.writeBinaryFile",
    "filesystem.appendFile",
    "filesystem.appendBinaryFile",
    "filesystem.openFile",
    "filesystem.updateOpenedFile",
    "filesystem.getOpenedFileInfo",
    "filesystem.readDirectory",
    "filesystem.copy",
    "filesystem.move",
    "filesystem.getStats",
    "filesystem.getAbsolutePath",
    "filesystem.getRelativePath",
    "filesystem.getJoinedPath",
    "filesystem.getNormalizedPath",
    "filesystem.getUnnormalizedPath",
    "filesystem.getPathParts",
    "filesystem.createWatcher",
    "filesystem.removeWatcher",
    "filesystem.getWatchers",
    "filesystem.getPermissions",
    "filesystem.setPermissions",
    "filesystem.access",
    "filesystem.chmod",
    "filesystem.chown",
    "os.*",
    "os.execCommand",
    "os.spawnProcess",
    "os.updateSpawnedProcess",
    "os.getSpawnedProcesses",
    "os.getEnv",
    "os.getEnvs",
    "os.setEnv",
    "os.showOpenDialog",
    "os.showSaveDialog",
    "os.showFolderDialog",
    "os.showNotification",
    "os.showMessageBox",
    "os.setTray",
    "os.open",
    "os.getPath",
    "os.trashItem",
    "os.getLocaleInfo",
    "storage.*",
    "storage.setData",
    "storage.getData",
    "storage.getKeys",
    "storage.removeData",
    "storage.clear",
    "debug.*",
    "debug.log",
    "clipboard.*",
    "clipboard.readText",
    "clipboard.writeText",
    "clipboard.readImage",
    "clipboard.writeImage",
    "clipboard.readHTML",
    "clipboard.writeHTML",
    "clipboard.clear",
    "clipboard.getFormat"
  ],
  "modes": {
    "window": {
      "title": "Custom LLM Client",
      "width": 1000,
      "height": 720,
      "minWidth": 600,
      "minHeight": 450,
      "resizable": true,
      "exitProcessOnClose": true,
      "enableInspector": false,
      "devtools": false
    }
  }
}